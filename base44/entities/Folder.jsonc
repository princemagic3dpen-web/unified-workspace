{
  "name": "Folder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du dossier"
    },
    "parent_id": {
      "type": "string",
      "description": "ID du dossier parent (null si racine)"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement li\u00e9"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "icon": {
      "type": "string",
      "default": "folder"
    },
    "path": {
      "type": "string",
      "description": "Chemin complet du dossier"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name"
  ]
}
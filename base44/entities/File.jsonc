{
  "name": "File",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du fichier"
    },
    "folder_id": {
      "type": "string",
      "description": "ID du dossier parent"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement li\u00e9"
    },
    "file_url": {
      "type": "string",
      "description": "URL du fichier upload\u00e9"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "document",
        "image",
        "video",
        "audio",
        "presentation",
        "spreadsheet",
        "pdf",
        "text",
        "other"
      ],
      "default": "other"
    },
    "mime_type": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "description": "Taille en bytes"
    },
    "content": {
      "type": "string",
      "description": "Contenu texte pour les fichiers texte"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "M\u00e9tadonn\u00e9es additionnelles"
    }
  },
  "required": [
    "name"
  ]
}
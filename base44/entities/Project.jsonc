{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du projet"
    },
    "company_id": {
      "type": "string",
      "description": "ID de l'entreprise"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparation",
        "in_progress",
        "review",
        "completed",
        "archived"
      ],
      "default": "preparation"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "completion_percentage": {
            "type": "number"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Phases du projet"
    },
    "team_members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "allocation_percentage": {
            "type": "number"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "spent": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "folder_id": {
      "type": "string",
      "description": "Dossier li\u00e9 au projet"
    },
    "ai_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommandations IA automatiques"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}
{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre notification"
    },
    "message": {
      "type": "string",
      "description": "Message"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error",
        "ai_suggestion"
      ],
      "default": "info"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "action": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "window_type": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "message"
  ]
}